{
  "version": 2,
  "functions": {"api/*.js": {"maxDuration": 10}},
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=300"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]},
    {"source": "/(.*)", "headers": [{"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}
  ]
}
